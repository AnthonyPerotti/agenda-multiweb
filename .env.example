# ============================================================
# Agenda Multiweb — Variáveis de Ambiente
# ============================================================

# ─── Porta do Host (Default: 80) ──────────────────────────
# Permite acessar via HTTP direto (ex: http://172.16.1.177 ou http://agenda.cte.edu)
FRONTEND_PORT="80"

# ─── Banco de Dados (SQLite) ──────────────────────────────
DATABASE_URL="file:./data/agenda.db"

# ─── NextAuth ─────────────────────────────────────────────
# Segredo de criptografia da sessão de login (gerar com: openssl rand -base64 32)
AUTH_SECRET="dev-secret-agenda-multiweb-cte-ufsm-2024"
NEXTAUTH_URL="http://172.16.1.177"

# ─── URL Pública do Site ──────────────────────────────────
# Endereço usado para gerar os links clicáveis nos e-mails
NEXT_PUBLIC_SITE_URL="http://172.16.1.177"

# ─── Node.js ──────────────────────────────────────────────
NODE_ENV="production"
